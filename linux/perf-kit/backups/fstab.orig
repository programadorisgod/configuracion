# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a device; this may
# be used with UUID= as a more robust way to name devices that works even if
# disks are added and removed. See fstab(5).
#
# <file system>             <mount point>  <type>  <options>  <dump>  <pass>
UUID=257C-152A                            /boot          vfat    defaults,umask=0077 0 2
UUID=0daa1308-ac14-44d7-b23f-277c361b11d1 /              btrfs   subvol=/@,defaults,noatime,compress=zstd 0 0
UUID=0daa1308-ac14-44d7-b23f-277c361b11d1 /home          btrfs   subvol=/@home,defaults,noatime,compress=zstd 0 0
UUID=0daa1308-ac14-44d7-b23f-277c361b11d1 /root          btrfs   subvol=/@root,defaults,noatime,compress=zstd 0 0
UUID=0daa1308-ac14-44d7-b23f-277c361b11d1 /srv           btrfs   subvol=/@srv,defaults,noatime,compress=zstd 0 0
UUID=0daa1308-ac14-44d7-b23f-277c361b11d1 /var/cache     btrfs   subvol=/@cache,defaults,noatime,compress=zstd 0 0
UUID=0daa1308-ac14-44d7-b23f-277c361b11d1 /var/tmp       btrfs   subvol=/@tmp,defaults,noatime,compress=zstd 0 0
UUID=0daa1308-ac14-44d7-b23f-277c361b11d1 /var/log       btrfs   subvol=/@var_log,defaults,noatime,compress=zstd 0 0
tmpfs                                     /tmp           tmpfs   defaults,noatime,mode=1777 0 0

# Btrfs swapfile for system hibernation
/swap/swapfile none swap defaults,pri=0 0 0
